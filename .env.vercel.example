NEX_AUTH_PUBLIC_URL=https://your-vercel-domain.vercel.app
NEX_AUTH_ADMIN_TOKEN=generate-a-long-random-admin-token
NEX_AUTH_ADMIN_EMAILS=owner@example.com
NEX_AUTH_COOKIE_NAME=nex_auth_session
NEX_AUTH_SESSION_TTL_SECONDS=2592000
NEX_AUTH_STATE_TTL_SECONDS=600
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
PARADOX_GATEWAY_URL=https://paradox-db.onrender.com/v1
PARADOX_API_KEY=your-paradox-api-key
PARADOX_PASSPHRASE=your-paradox-passphrase
PARADOX_PROJECT=nexuss-auth
PARADOX_DATABASE=nexuss-auth
