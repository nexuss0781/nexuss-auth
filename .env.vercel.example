NEX_AUTH_PUBLIC_URL=https://your-vercel-domain.vercel.app
NEX_AUTH_ADMIN_TOKEN=generate-a-long-random-admin-token
NEX_AUTH_COOKIE_NAME=nex_auth_session
NEX_AUTH_SESSION_TTL_SECONDS=2592000
NEX_AUTH_STATE_TTL_SECONDS=600
# Canonical Paradox URL required by the production Vercel adapter (secret-bearing; keep only in Vercel env).
DATABASE_URL=parad://<PARADOX_API_KEY>@local/<PARADOX_PROJECT>/<PARADOX_DATABASE>?passphrase=<URL_ENCODED_PASSPHRASE>&gateway=https://paradox-db.wasmer.app/v1
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# ENVX Supabase Auth OAuth-server OIDC client settings (configure after project access and client registration)
ENVX_OIDC_ISSUER_URL=https://YOUR_PROJECT.supabase.co/auth/v1
ENVX_OIDC_CLIENT_ID=
ENVX_OIDC_CLIENT_SECRET=
