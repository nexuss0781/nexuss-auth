{
  "name": "nex-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w nexuss-auth && npm run build -w @nex-auth/server && npm run build -w @nex-auth/dashboard",
    "test": "npm run test -w nexuss-auth && npm run test -w @nex-auth/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dashboard:dev": "npm run dev -w @nex-auth/dashboard",
    "dashboard:build": "npm run build -w @nex-auth/dashboard",
    "dashboard:typecheck": "npm run typecheck -w @nex-auth/dashboard"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vercel/node": "^5.10.1"
  }
}
