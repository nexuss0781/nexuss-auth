{
  "name": "nexuss-auth",
  "version": "1.0.1",
  "description": "Framework-agnostic browser SDK and CLI for Nexuss Auth Google, GitHub, and ENVX OIDC login",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexuss0781/nexuss-auth.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "nexuss-auth": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL"
  ],
  "sideEffects": false,
  "scripts": {
    "prepack": "node ../../scripts/sync-skill-package.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
