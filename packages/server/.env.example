NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nex_auth
NEX_AUTH_PUBLIC_URL=http://localhost:8787
NEX_AUTH_ADMIN_TOKEN=replace-with-a-long-random-admin-token
NEX_AUTH_COOKIE_NAME=nex_auth_session
NEX_AUTH_SESSION_TTL_SECONDS=2592000
NEX_AUTH_STATE_TTL_SECONDS=600
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
